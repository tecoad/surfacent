{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Runs as-is in Node (Tailwind loads the plugin with native type stripping),
    // so only erasable syntax and explicit type imports.
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src", "scripts", "test"]
}
