{
  "name": "surfacent",
  "version": "0.1.0",
  "description": "Say what an element is, not what it looks like: data-* intents that a Tailwind CSS v4 plugin turns into CSS, relative to where each element sits. With a toolbar to pick them on the page and an MCP server for coding agents.",
  "license": "MIT AND PolyForm-Shield-1.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind": "./dist/tailwind.js",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "surfacent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "prepack": "npm run build && cp ../../README.md README.md"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tailwind",
    "tailwindcss",
    "tailwind-plugin",
    "design-system",
    "intent",
    "data-attributes",
    "surfaces",
    "toolbar",
    "vite-plugin",
    "mcp",
    "coding-agents",
    "claude-code"
  ],
  "author": {
    "name": "Matt Silva",
    "url": "https://github.com/tecoad"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tecoad/surfacent.git",
    "directory": "packages/surfacent"
  },
  "homepage": "https://github.com/tecoad/surfacent#readme",
  "bugs": {
    "url": "https://github.com/tecoad/surfacent/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": "^4.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
